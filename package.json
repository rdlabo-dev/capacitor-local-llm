{
  "name": "@rdlabo/capacitor-local-llm",
  "version": "2.1.0",
  "description": "A Capacitor plugin for running on-device LLMs, with support for text generation, image generation, and session management on iOS and Android.",
  "main": "dist/plugin.cjs.js",
  "module": "dist/esm/index.js",
  "types": "dist/esm/index.d.ts",
  "unpkg": "dist/plugin.js",
  "files": [
    "android/src/main/",
    "android/build.gradle",
    "dist/",
    "docs/",
    "ios/Sources",
    "NOTICE",
    "Package.swift",
    "CapacitorLocalLlm.podspec"
  ],
  "author": "Masahiko Sakakibara <sakakibara@rdlabo.jp>",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/rdlabo-dev/capacitor-local-llm.git"
  },
  "bugs": {
    "url": "https://github.com/rdlabo-dev/capacitor-local-llm/issues"
  },
  "homepage": "https://github.com/rdlabo-dev/capacitor-local-llm#readme",
  "publishConfig": {
    "access": "public"
  },
  "keywords": [
    "capacitor",
    "plugin",
    "native",
    "llm",
    "ai",
    "on-device",
    "local-llm",
    "machine-learning",
    "ios",
    "android"
  ],
  "scripts": {
    "verify": "npm run verify:ios && npm run verify:android && npm run verify:web",
    "verify:ios": "swift build --build-tests --sdk \"$(xcrun --sdk iphoneos --show-sdk-path)\" --triple arm64-apple-ios18.4 && npm run test:ios",
    "verify:android": "cd android && ./gradlew clean build test && cd ..",
    "verify:web": "npm run build",
    "test": "npm run test:types",
    "test:ios": "xcodebuild test -scheme CapacitorLocalLlm -destination 'platform=iOS Simulator,name=iPhone 17 Pro,OS=latest'",
    "test:types": "tsc -p tests/tsconfig.json --noEmit",
    "lint": "npm run eslint && npm run prettier -- --check && npm run swiftlint -- lint --no-cache",
    "fmt": "npm run eslint -- --fix && npm run prettier -- --write && npm run swiftlint -- --fix --format --no-cache",
    "eslint": "eslint . --ext ts",
    "prettier": "prettier \"**/*.{css,html,ts,js,java}\" --plugin=prettier-plugin-java",
    "swiftlint": "node-swiftlint",
    "docgen": "docgen --api LocalLLMPlugin --output-readme README.md --output-json dist/docs.json",
    "build": "npm run clean && npm run docgen && tsc && rollup -c rollup.config.mjs",
    "clean": "rimraf ./dist",
    "watch": "tsc --watch",
    "prepublishOnly": "npm run build",
    "release": "np --no-tests --no-publish"
  },
  "devDependencies": {
    "@capacitor/android": "^8.1.0",
    "@capacitor/core": "^8.1.0",
    "@capacitor/ios": "^8.1.0",
    "@ionic/eslint-config": "^0.4.0",
    "@ionic/prettier-config": "^4.0.0",
    "@ionic/swiftlint-config": "^2.0.0",
    "@rdlabo/capacitor-docgen": "^0.4.1",
    "@typescript-eslint/eslint-plugin": "^8.59.1",
    "eslint": "^8.57.1",
    "eslint-plugin-import": "^2.32.0",
    "np": "^10.2.0",
    "prettier": "^3.8.1",
    "prettier-plugin-java": "^2.8.1",
    "rimraf": "^6.1.3",
    "rollup": "^4.59.0",
    "swiftlint": "^2.0.0",
    "typescript": "~5.9.3"
  },
  "peerDependencies": {
    "@capacitor/core": ">=8.0.0"
  },
  "prettier": "@ionic/prettier-config",
  "eslintConfig": {
    "extends": "@ionic/eslint-config/recommended"
  },
  "capacitor": {
    "ios": {
      "src": "ios"
    },
    "android": {
      "src": "android"
    }
  }
}
